APP_ENV=production
FLASK_SECRET_KEY=replace-with-a-very-long-random-secret
KIOSK_SCAN_API_TOKEN=replace-with-a-very-long-random-token
DEFAULT_STUDENT_PASSWORD=replace-with-temporary-student-password

# Use one of these for Google Service Account credentials:
# SERVICE_ACCOUNT_JSON can be a local file path or the full JSON string.
# SERVICE_ACCOUNT_JSON_B64 can be base64-encoded JSON for hosts that dislike multiline env values.
SERVICE_ACCOUNT_JSON=
SERVICE_ACCOUNT_JSON_B64=
SERVICE_ACCOUNT_JSON_FILE=config/service_account.json

OPENAI_API_KEY=replace-with-openai-api-key

# Gmail API uses a separate OAuth client from the Sheets/Drive service account.
# Authorize only https://www.googleapis.com/auth/gmail.send and store the refresh token securely.
GMAIL_CLIENT_ID=replace-with-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-gmail-oauth-refresh-token
GMAIL_SENDER_EMAIL=sender@gmail.com
EMAIL_DISPATCH_TOKEN=replace-with-a-long-random-dispatch-token
NOTIFICATION_TIMEZONE=Asia/Seoul

MENU_SHEET_ID=replace-with-menu-sheet-id
STUDENT_SHEET_ID=replace-with-student-sheet-id
LOGIN_SHEET_ID=replace-with-login-sheet-id
LOG_SHEET_ID=replace-with-log-sheet-id
PUBLIC_ADMIN_URL=https://your-admin-server.example.com
RFID_DASHBOARD_URL=https://your-rfid-dashboard.example.com
SESSION_TIMEOUT_MINUTES=60
SESSION_COOKIE_SECURE=1
